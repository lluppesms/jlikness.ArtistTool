@inject IImageManager ImageManager
@inject IPhotoDatabase photoDb
@rendermode InteractiveServer

<div class="upload-header">
    <h3>Upload your photographs</h3>
    <p class="upload-summary">Upload a file (up to 20 MB each). Supported formats: <span>.jpg, .jpeg, .gif, .tif, .tiff, .png</span>.</p>

    <div class="upload-input-group">
        <label class="upload-label">
            <span>Select a file to add to your library</span>
            <InputFile class="upload-input" OnChange="LoadFiles" multiple disabled="@isLoading" />
        </label>
    </div>

    <div class="upload-toggle">
        <label class="toggle-label">
            <input type="checkbox" @bind="useAI" @bind:after="ToggleAI" />
            <span class="toggle-text">Use Agentic Mode</span>
        </label>
    </div>

    @if (!useAI)
    {
        <div class="upload-metadata">
            <div class="metadata-field">
                <label for="description">Description</label>
                <textarea id="description" @bind="description" placeholder="Enter photo description..." rows="3"></textarea>
            </div>
            <div class="metadata-field">
                <label for="category">Category</label>
                <select id="category" @bind="selectedCategory">
                    <option value="">Select a category...</option>
                    @foreach (var category in Categories)
                    {
                        <option value="@category.Name">@category.Name</option>
                    }
                </select>
            </div>
            <div class="metadata-field">
                <label for="tags">Tags</label>
                <textarea id="tags" @bind="tags" placeholder="Enter tags..." rows="3"></textarea>
            </div>
        </div>
    }
</div>


@if (isLoading)
{
    <p class="upload-status">Uploading and analyzing...</p>
}

<div class="upload-results">
    <h4>Results</h4>
    <ul>
        @foreach (var result in results)
        {
            <li>@result</li>
        }
    </ul>
</div>

<div class="upload-actions">
    <button class="btn-secondary" @onclick="Done" disabled="@isLoading">Done</button>
</div>

@code {

    [Parameter]
    public bool AddingPhotographs { get; set; }

    [Parameter]
    public EventCallback<bool> AddingPhotographsChanged { get; set; }

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    private List<string> results = [];
    private long maxFileSize = 20 * Utility.Megabyte;
    private int maxAllowedFiles = 10;
    private bool isLoading;
    private bool useAI = false;
    private string description = string.Empty;
    private string tags = string.Empty;
    private string selectedCategory = string.Empty;
    public List<Category> Categories { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Categories.Count == 0)
        {
            Categories = (await photoDb.ListCategoriesAsync()).ToList();
        }
    }

    private void ToggleAI()
    {
        // Clear fields when toggling AI on
        if (useAI)
        {
            description = string.Empty;
            selectedCategory = string.Empty;
        }
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(maxAllowedFiles);
        isLoading = true;
        StateHasChanged();
        results.Clear();

        foreach (var file in files)
        {
            try
            {
                await ImageManager.SaveImageAsync(file.Name, file.ContentType,
                    async fs =>
                    {
                        await using var source = file.OpenReadStream(maxFileSize);
                        await source.CopyToAsync(fs);
                    });
                results.Add($"Successfully loaded '{file.Name}' ({file.Size.AsByteSize()}) - {file.ContentType}");
            }
            catch (Exception ex)
            {
                results.Add($"Issue adding {file.Name}: {ex.Message}");
            }
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task Done()
    {
        if (isLoading) return;
        AddingPhotographs = false;
        await AddingPhotographsChanged.InvokeAsync(false);
        if (OnCompleted.HasDelegate)
        {
            await OnCompleted.InvokeAsync();
        }
    }

}